<template>
  <header class="todo-header">
    <h1>{{ props.title || "todos" }}</h1>
    <TodoTextInput bind:initialValue="''" bind:placeholder="'What needs to be done?'" on:submit="handleCreate" />
  </header>
</template>

<script lang="ts">
  import TodoTextInput from "./TodoTextInput.weiv";

  export interface Props {
    title: string;
  }

  export let props: Props;

  function handleCreate(text: string) {
    emit("create", text);
  }
</script>

