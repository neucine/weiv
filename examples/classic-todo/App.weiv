<template>
  <main class="todo-app">
    <div class="todo-app__shell">
      <header class="todo-app__hero">
        <p class="todo-app__eyebrow">Verification Example</p>
        <div class="todo-app__headline">
          <h1>{{ props.title }}</h1>
          <p class="todo-app__lede">Client runtime, nested components, scoped styles, and TS-backed helpers in one polished example.</p>
        </div>
        <div class="todo-app__summary">
          <strong>{{ summary() }}</strong>
          <span>{{ showCompleted ? "Viewing completed tasks" : "Viewing active tasks" }}</span>
        </div>
      </header>

      <section class="todo-app__panel">
        <div class="todo-app__panel-header">
          <div>
            <p class="todo-app__panel-label">Inbox</p>
            <h2>Product Todo Board</h2>
          </div>
          <button class="todo-app__filter" on:click="toggleCompletedFilter">
            {{ showCompleted ? "Show active" : "Show completed" }}
          </button>
        </div>

        <TodoList
          bind:items="visibleItems()"
          bind:showCompleted="showCompleted"
          on:toggle="toggleItem"
        />
      </section>
    </div>
  </main>
</template>

<script lang="ts">
  import TodoList from "./TodoList.weiv";

  export interface Todo {
    id: string;
    title: string;
    completed: boolean;
  }

  export interface Props {
    title: string;
  }

  export let props: Props;

  let showCompleted = false;
  let items: Todo[] = [
    { id: "1", title: "Ship recursive helper import support", completed: true },
    { id: "2", title: "Polish the flagship todo verification app", completed: false },
    { id: "3", title: "Tighten DOM event semantics", completed: false },
    { id: "4", title: "Document the client preview workflow", completed: true }
  ];

  function visibleItems() {
    return items.filter((item) => item.completed === showCompleted);
  }

  function summary() {
    return `${visibleItems().length} ${showCompleted ? "completed" : "active"} tasks`;
  }

  function toggleCompletedFilter() {
    showCompleted = !showCompleted;
  }

  function toggleItem(itemId: string) {
    items = items.map((item) =>
      item.id === itemId ? { ...item, completed: !item.completed } : item
    );
  }
</script>

