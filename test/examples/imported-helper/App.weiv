<template>
  <section class="imported-helper">
    <h1>{{ headline() }}</h1>
    <p>{{ props.count }}</p>
  </section>
</template>

<script lang="ts">
  import { formatTitle } from "./format.js";

  export interface Props {
    title: string;
    count: number;
  }

  export let props: Props;

  function headline() {
    return formatTitle(props.title);
  }
</script>

<style>
  .imported-helper {
    display: grid;
    gap: 0.5rem;
  }
</style>
