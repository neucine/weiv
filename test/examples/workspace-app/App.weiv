<template>
  <WorkspaceShell bind:collapsed="shellState.collapsed">
    <template slot:header>
      <WorkspaceHeader
        bind:collapsed="shellState.collapsed"
        bind:notifications="workspaceShared.notifications"
        bind:pendingSaves="saveState.pending ? 1 : 0"
        bind:subtitle="headerSubtitle()"
        bind:title="props.workspaceName"
        on:clear-notifications="clearHeaderNotifications"
        on:queue-refresh="queueRefresh"
        on:toggle-sidebar="toggleSidebar"
      />
    </template>

    <template slot:sidebar>
      <WorkspaceSidebar
        bind:activeSection="activeSection"
        bind:collapsed="shellState.collapsed"
        bind:statusMessage="shellState.statusMessage"
        on:select-section="selectSection"
      />
    </template>

    <DashboardSection
      if="activeSection === 'overview'"
      bind:activeSegment="metricSegment"
      bind:metrics="visibleMetrics()"
      bind:pendingCount="openItemCount()"
      bind:pinnedCount="pinnedItemCount()"
      bind:refreshCount="refreshCount"
      bind:statusMessage="shellState.statusMessage"
      bind:summary="overviewSummary()"
      on:select-segment="selectMetricSegment"
    />

    <ActivityFeed
      bind:filter="feedFilter"
      bind:items="visibleFeedItems()"
      bind:selectedId="workspaceShared.selectedItemId"
      bind:sharedPulse="workspaceShared.pulse"
      on:select-item="selectItem"
      on:set-filter="setFeedFilter"
      on:toggle-pin="togglePin"
    />

    <template slot:detail>
      <DetailPanel
        bind:externalTicks="externalTicks"
        bind:item="selectedItem()"
        bind:lastSavedLabel="lastSavedLabel()"
        bind:pending="saveState.pending"
        on:register-external-watch="registerExternalWatch"
        on:save-item="saveItem"
        on:trigger-external-pulse="triggerExternalPulse"
      />
    </template>
  </WorkspaceShell>
</template>

<script lang="ts">
  import DashboardSection from "./DashboardSection.weiv";
  import ActivityFeed from "./ActivityFeed.weiv";
  import DetailPanel from "./DetailPanel.weiv";
  import WorkspaceHeader from "./WorkspaceHeader.weiv";
  import WorkspaceShell from "./WorkspaceShell.weiv";
  import WorkspaceSidebar from "./WorkspaceSidebar.weiv";
  import { formatRelativeMinutes } from "./format.ts";
  import {
    bumpNotifications,
    bumpSharedPulse,
    clearNotifications,
    emitExternalPulse,
    registerExternalPulseListener,
    setSelectedItemId,
    workspaceShared
  } from "./workspace_shared.ts";

  export type Section = "overview" | "activity" | "details";
  export type FeedFilter = "all" | "pinned" | "open";
  export type MetricSegment = "today" | "week";

  export interface Props {
    workspaceName: string;
    initialSection: Section;
  }

  export interface Metric {
    id: string;
    label: string;
    value: string;
    change: number;
    segment: MetricSegment;
  }

  export interface ActivityItem {
    id: string;
    title: string;
    summary: string;
    detail: string;
    owner: string;
    pinned: boolean;
    state: "open" | "review" | "done";
  }

  export let props: Props;

  let shellState = {
    collapsed: false,
    statusMessage: "Review blockers before the Friday release cut."
  };
  let saveState = {
    pending: false,
    lastSavedMinutes: 12
  };

  let activeSection: Section = props.initialSection || "overview";
  let feedFilter: FeedFilter = "all";
  let metricSegment: MetricSegment = "today";
  let refreshCount = 0;
  let externalTicks = 0;
  let externalWatchRegistered = false;

  let metrics: Metric[] = [
    { id: "m-1", label: "Open blockers", value: "3", change: -1, segment: "today" },
    { id: "m-2", label: "Approvals waiting", value: "5", change: 2, segment: "today" },
    { id: "m-3", label: "Queued fixes", value: "4", change: 1, segment: "today" },
    { id: "m-4", label: "Checks passing", value: "26", change: 4, segment: "week" },
    { id: "m-5", label: "Release notes done", value: "8", change: 0, segment: "week" },
    { id: "m-6", label: "Risk calls pending", value: "2", change: -1, segment: "week" }
  ];

  let items: ActivityItem[] = [
    {
      id: "activity-1",
      title: "Confirm rollback checklist",
      summary: "Ops needs final confirmation before the release train opens.",
      detail: "Verify the rollback owner, status page steps, and rollback threshold before sign-off.",
      owner: "Avery · Ops",
      pinned: true,
      state: "open"
    },
    {
      id: "activity-2",
      title: "Approve checkout fix",
      summary: "Payments patch is ready for review and release approval.",
      detail: "Read the mitigation notes, confirm test coverage, and approve the checkout fix for rollout.",
      owner: "Mika · Payments",
      pinned: false,
      state: "review"
    },
    {
      id: "activity-3",
      title: "Publish release note summary",
      summary: "Comms is waiting on the final customer-facing summary.",
      detail: "Draft the release note summary, confirm the changed feature flags, and hand off to comms.",
      owner: "Noa · Product",
      pinned: false,
      state: "done"
    }
  ];

  function headerSubtitle() {
    return `${overviewSummary()} · ${shellState.statusMessage}`;
  }

  function overviewSummary() {
    return `${visibleMetrics().length} readiness metrics · ${visibleFeedItems().length} visible work items`;
  }

  function visibleMetrics() {
    return metrics.filter((metric) => metric.segment === metricSegment);
  }

  function visibleFeedItems() {
    if (feedFilter === "pinned") {
      return items.filter((item) => item.pinned);
    }
    if (feedFilter === "open") {
      return items.filter((item) => item.state !== "done");
    }
    return items;
  }

  function pinnedItemCount() {
    return items.filter((item) => item.pinned).length;
  }

  function openItemCount() {
    return items.filter((item) => item.state !== "done").length;
  }

  function selectedItem() {
    return items.find((item) => item.id === workspaceShared.selectedItemId) || null;
  }

  function lastSavedLabel() {
    return formatRelativeMinutes(saveState.lastSavedMinutes);
  }

  function toggleSidebar() {
    shellState.collapsed = !shellState.collapsed;
    shellState.statusMessage = shellState.collapsed ? "Compact navigation enabled." : "Navigation expanded.";
  }

  function clearHeaderNotifications() {
    clearNotifications();
    shellState.statusMessage = "Release alerts cleared.";
  }

  function queueRefresh() {
    shellState.statusMessage = "Refreshing the release status board.";
    queueMicrotask(() => {
      refreshCount += 1;
      saveState.lastSavedMinutes += 1;
      shellState.statusMessage = `Release status refresh ${refreshCount} completed.`;
    });
  }

  function selectSection(section: Section) {
    activeSection = section;
    shellState.statusMessage = `Switched to the ${section} view.`;
  }

  function selectMetricSegment(segment: MetricSegment) {
    metricSegment = segment;
    shellState.statusMessage = `Showing ${segment} readiness metrics.`;
  }

  function setFeedFilter(filter: FeedFilter) {
    feedFilter = filter;
    shellState.statusMessage = `Queue filter is now ${filter}.`;
  }

  function selectItem(itemId: string) {
    setSelectedItemId(itemId);
    activeSection = "details";
    shellState.statusMessage = `Opened ${itemId} for review.`;
  }

  function togglePin(itemId: string) {
    items = items.map((item) =>
      item.id === itemId ? { ...item, pinned: !item.pinned } : item
    );
    shellState.statusMessage = "Updated the release queue priority.";
  }

  function saveItem(itemId: string) {
    saveState.pending = true;
    shellState.statusMessage = "Saving the release decision...";

    setTimeout(() => {
      items = items.map((item) =>
        item.id === itemId ? { ...item, state: "done" } : item
      );
      saveState.pending = false;
      saveState.lastSavedMinutes = 0;
      bumpNotifications();
      shellState.statusMessage = "Saved the release decision through an owned timer callback.";
    }, 0);
  }

  function registerExternalWatch() {
    if (externalWatchRegistered) {
      shellState.statusMessage = "Release alert feed is already connected.";
      return;
    }

    externalWatchRegistered = true;
    registerExternalPulseListener(() => {
      externalTicks += 1;
      shellState.statusMessage = `Received external update ${externalTicks}.`;
    });
    shellState.statusMessage = "Connected the release alert feed.";
  }

  function triggerExternalPulse() {
    bumpSharedPulse();
    emitExternalPulse();
  }
</script>

<style>
  :global(body) {
    margin: 0;
  }
</style>
