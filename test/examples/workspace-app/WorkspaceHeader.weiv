    border: 1px solid #d7e0e8;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.84);
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 50px rgba(24, 44, 66, 0.08);
  }

  .workspace-header__eyebrow,
  .workspace-header__subtitle,
  .workspace-header__badge,
  .workspace-header__notification {
    color: #607086;
  }

  .workspace-header__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: end;
    gap: 0.75rem;
  }

  .workspace-header__ghost,
  .workspace-header__primary {
    border-radius: 999px;
    padding: 0.75rem 1rem;
    font: inherit;
    cursor: pointer;
  }

  .workspace-header__ghost {
    border: 1px solid #cad4df;
