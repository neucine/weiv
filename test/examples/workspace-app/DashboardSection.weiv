<template>
  <section class="dashboard-section">
    <Panel>
      <template slot:header>
        <div>
          <h2>Release overview</h2>
          <p class="dashboard-section__subhead">{{ props.summary }}</p>
        </div>
      </template>

      <template slot:actions>
        <button bind:class="segmentClass('today')" on:click="selectToday">Today</button>
        <button bind:class="segmentClass('week')" on:click="selectWeek">Week</button>
      </template>

      <MetricGrid bind:metrics="props.metrics" />
    </Panel>

    <Panel>
      <template slot:header>
        <div>
          <h2>Decision signals</h2>
          <p class="dashboard-section__subhead">{{ props.statusMessage }}</p>
        </div>
      </template>

      <ul class="dashboard-section__facts">
        <li>{{ props.pendingCount }} work items still need action</li>
        <li>{{ props.pinnedCount }} items are pinned for release review</li>
        <li>{{ props.refreshCount }} queued sync cycles completed</li>
      </ul>
    </Panel>
  </section>
</template>

<script lang="ts">
  import MetricGrid from "./MetricGrid.weiv";
  import Panel from "./Panel.weiv";

  export type Segment = "today" | "week";

  export interface Metric {
    id: string;
    label: string;
    value: string;
    change: number;
  }

  export interface Props {
    metrics: Metric[];
    activeSegment: Segment;
    summary: string;
    pendingCount: number;
    pinnedCount: number;
    refreshCount: number;
    statusMessage: string;
  }

  export let props: Props;

  function segmentClass(segment: Segment) {
    return props.activeSegment === segment
      ? "dashboard-section__segment dashboard-section__segment--active"
      : "dashboard-section__segment";
  }

  function selectToday() {
    emit("select-segment", "today");
  }

  function selectWeek() {
    emit("select-segment", "week");
  }
</script>

<style>
  .dashboard-section {
    display: grid;
    gap: 1rem;
  }

  .dashboard-section__subhead {
    color: #647389;
  }

  .dashboard-section__segment {
    margin-left: 0.5rem;
    border: 1px solid #dbe4ec;
    border-radius: 999px;
    padding: 0.55rem 0.85rem;
    background: #fff;
    font: inherit;
    cursor: pointer;
  }

  .dashboard-section__segment--active {
    border-color: #182c42;
    background: #182c42;
    color: #fff;
  }

  .dashboard-section__facts {
    display: grid;
    gap: 0.5rem;
    color: #42556c;
  }
</style>
