<template>
  <nav bind:class="sidebarClass()">
    <p if="!props.collapsed" class="workspace-sidebar__label">Release views</p>

    <button bind:class="sectionClass('overview')" on:click="showOverview">
      <span>Overview</span>
      <small if="!props.collapsed">health, trends, approvals</small>
    </button>
    <button bind:class="sectionClass('activity')" on:click="showActivity">
      <span>Queue</span>
      <small if="!props.collapsed">priorities, owners, selection</small>
    </button>
    <button bind:class="sectionClass('details')" on:click="showDetails">
      <span>Details</span>
      <small if="!props.collapsed">decisions, saves, external sync</small>
    </button>

    <p if="!props.collapsed" class="workspace-sidebar__status">{{ props.statusMessage }}</p>
  </nav>
</template>

<script lang="ts">
  export type Section = "overview" | "activity" | "details";

  export interface Props {
    activeSection: Section;
    collapsed: boolean;
    statusMessage: string;
  }

  export let props: Props;

  function sidebarClass() {
    return props.collapsed ? "workspace-sidebar workspace-sidebar--collapsed" : "workspace-sidebar";
  }

  function sectionClass(section: Section) {
    return props.activeSection === section
      ? "workspace-sidebar__item workspace-sidebar__item--active"
      : "workspace-sidebar__item";
  }

  function showOverview() {
    emit("select-section", "overview");
  }

  function showActivity() {
    emit("select-section", "activity");
  }

  function showDetails() {
    emit("select-section", "details");
  }
</script>

<style>
  .workspace-sidebar {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid #d7e0e8;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.92);
  }

  .workspace-sidebar__label,
  .workspace-sidebar__status {
    color: #6d7b8d;
  }

  .workspace-sidebar__item {
    display: grid;
    gap: 0.2rem;
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid #dde5ed;
    border-radius: 16px;
    background: #fff;
    color: #182c42;
    text-align: left;
    font: inherit;
    cursor: pointer;
  }

  .workspace-sidebar__item--active {
    border-color: #182c42;
    background: #182c42;
    color: #fff;
  }

  .workspace-sidebar__item small {
    opacity: 0.75;
  }

  .workspace-sidebar--collapsed {
    padding: 0.75rem;
  }

  .workspace-sidebar--collapsed .workspace-sidebar__item {
    min-height: 4.5rem;
    justify-items: center;
    align-content: center;
    padding: 0.7rem 0.45rem;
    text-align: center;
  }

  .workspace-sidebar--collapsed .workspace-sidebar__item span {
    display: block;
    max-width: 100%;
    font-size: 0.82rem;
    line-height: 1.15;
    word-break: break-word;
  }
</style>
