<template>
  <div class="workspace-header">
    <div>
      <p class="workspace-header__eyebrow">Kaneo-inspired verification app</p>
      <h1>{{ props.title }}</h1>
      <p class="workspace-header__subtitle">{{ props.subtitle }}</p>
    </div>

    <div class="workspace-header__actions">
      <span class="workspace-header__section">{{ props.sectionLabel }}</span>
      <button class="workspace-header__ghost" @click="handleOpenNotifications">Open notifications</button>
      <button class="workspace-header__ghost" @click="handleQueueRefresh">Sync updates</button>
      <button class="workspace-header__ghost" @click="handleClearNotifications">Clear notifications</button>
      <button class="workspace-header__primary" @click="handleToggleSidebar">
        {{ props.collapsed ? "Expand sidebar" : "Collapse sidebar" }}
      </button>
      <span class="workspace-header__notification">{{ props.notifications }} notifications</span>
    </div>
  </div>
</template>

<script lang="ts">
  export interface Props {
    title: string;
    subtitle: string;
    sectionLabel: string;
    notifications: number;
    collapsed: boolean;
  }

  export let props: Props;

  function handleToggleSidebar() {
    emit("toggle-sidebar", null);
  }

  function handleQueueRefresh() {
    emit("queue-refresh", null);
  }

  function handleOpenNotifications() {
    emit("open-notifications", null);
  }

  function handleClearNotifications() {
    emit("clear-notifications", null);
  }
</script>

