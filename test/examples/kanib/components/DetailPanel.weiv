<template>
  <Panel>
    <template slot:header>
      <div>
        <h2>Selected issue</h2>
        <p class="detail-panel__subhead">Quick actions stay visible across routes.</p>
      </div>
    </template>

    <template slot:actions>
      <button class="detail-panel__ghost" on:click="registerWatch">Connect save listener</button>
      <button class="detail-panel__ghost" on:click="triggerExternalPulse">Trigger external save</button>
    </template>

    <EmptyState if="!props.item">
      <template slot:message>
        <p>No issue is selected yet.</p>
      </template>
      <p>Open any issue from the list or board to keep the side panel in sync.</p>
    </EmptyState>

    <section else class="detail-panel__content">
      <header class="detail-panel__headline">
        <strong>{{ props.item.title }}</strong>
        <span>{{ props.item.status }}</span>
      </header>

      <DetailSection bind:body="props.item.summary" bind:title="'Summary'" />
      <DetailSection bind:body="props.item.detail" bind:title="'Detail'" />

      <footer class="detail-panel__footer">
        <p class="detail-panel__ticks">External save pulses: {{ props.externalTicks }}</p>
        <div class="detail-panel__actions">
          <button class="detail-panel__ghost" on:click="openIssue">Open detail</button>
          <button class="detail-panel__primary" on:click="advanceIssue">Advance status</button>
        </div>
      </footer>
    </section>
  </Panel>
</template>

<script lang="ts">
  import DetailSection from "./DetailSection.weiv";
  import EmptyState from "./EmptyState.weiv";
  import Panel from "./Panel.weiv";

  export interface DetailItem {
    id: string;
    title: string;
    summary: string;
    detail: string;
    status: string;
  }

  export interface Props {
    item: DetailItem | null;
    workspaceId: string;
    externalTicks: number;
  }

  export let props: Props;

  function openIssue() {
    if (!props.item) {
      return;
    }
    emit("open-issue", props.item.id);
  }

  function advanceIssue() {
    if (!props.item) {
      return;
    }
    emit("advance-issue", props.item.id);
  }

  function registerWatch() {
    emit("register-external-watch", null);
  }

  function triggerExternalPulse() {
    emit("trigger-external-pulse", null);
  }
</script>

<style>
  .detail-panel__subhead,
  .detail-panel__ticks {
    color: #6b7a8d;
  }

  .detail-panel__content {
    display: grid;
    gap: 0.75rem;
  }

  .detail-panel__headline,
  .detail-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .detail-panel__actions {
    display: flex;
    gap: 0.6rem;
  }

  .detail-panel__ghost,
  .detail-panel__primary {
    border-radius: 999px;
    padding: 0.55rem 0.85rem;
    font: inherit;
    cursor: pointer;
  }

  .detail-panel__ghost {
    border: 1px solid #dbe4ec;
    background: #fff;
  }

  .detail-panel__primary {
    border: none;
    background: #182c42;
    color: #fff;
  }
</style>
