<template>
  <main :class="shellClass()">
    <header class="workspace-shell__header">
      <slot name="header"></slot>
    </header>

    <section class="workspace-shell__toolbar">
      <slot name="toolbar"></slot>
    </section>

    <div class="workspace-shell__body">
      <aside class="workspace-shell__sidebar">
        <slot name="sidebar"></slot>
      </aside>

      <section class="workspace-shell__main">
        <slot></slot>
      </section>

      <aside class="workspace-shell__detail">
        <slot name="detail"></slot>
      </aside>
    </div>
  </main>
</template>

<script lang="ts">
  export interface Props {
    collapsed: boolean;
  }

  export let props: Props;

  function shellClass() {
    return props.collapsed ? "workspace-shell workspace-shell--collapsed" : "workspace-shell";
  }
</script>

<style>
  .workspace-shell {
    min-height: 100vh;
    padding: 1.25rem;
    background:
      radial-gradient(circle at 12% 2%, rgba(255, 214, 166, 0.65), transparent 30%),
      radial-gradient(circle at 88% 4%, rgba(190, 220, 255, 0.55), transparent 33%),
      linear-gradient(180deg, #f8fbff 0%, #edf3f8 100%);
    color: #182c42;
    font-family: "IBM Plex Sans", "Helvetica Neue", sans-serif;
  }

  .workspace-shell__body {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 320px;
    gap: 1rem;
    align-items: start;
  }

  .workspace-shell--collapsed .workspace-shell__body {
    grid-template-columns: 120px minmax(0, 1fr) 320px;
  }

  .workspace-shell__header {
    margin-bottom: 0.75rem;
  }

  .workspace-shell__toolbar {
    margin-bottom: 1rem;
  }

  .workspace-shell__main,
  .workspace-shell__detail {
    min-width: 0;
  }

  @media (max-width: 1100px) {
    .workspace-shell__body,
    .workspace-shell--collapsed .workspace-shell__body {
      grid-template-columns: 1fr;
    }
  }
</style>
