{
  "name": "weivjs",
  "version": "0.1.0",
  "type": "module",
  "description": "Weiv compiler CLI, virtual runtime modules, and bundler adapters (Bun + Vite)",
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "generate:types": "node ./scripts/generate-types.mjs",
    "prepack": "npm run build && npm run generate:types"
  },
  "files": [
    "README.md",
    "bin",
    "dist",
    "types",
    "package.json"
  ],
  "bin": {
    "weiv": "./bin/weiv.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./dist/vite.mjs"
    },
    "./bun": {
      "types": "./types/bun.d.ts",
      "default": "./dist/bun.mjs"
    }
  },
  "optionalDependencies": {
    "@weivjs/weiv-darwin-arm64": "0.1.0",
    "@weivjs/weiv-darwin-x64": "0.1.0",
    "@weivjs/weiv-linux-x64-gnu": "0.1.0",
    "@weivjs/weiv-linux-arm64-gnu": "0.1.0",
    "@weivjs/weiv-win32-x64-msvc": "0.1.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affon-ai/weiv.git"
  },
  "bugs": {
    "url": "https://github.com/affon-ai/weiv/issues"
  },
  "homepage": "https://github.com/affon-ai/weiv#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "weiv",
    "compiler",
    "frontend",
    "sfc",
    "vite",
    "bun"
  ]
}
